{
  "name": "shepherd-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "cap:copy": "npm run build && npx cap copy",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "test:lambda": "tsc -p tsconfig.lambda-tests.json && node --test .test-dist/tests/**/*.test.js",
    "preview": "vite preview",
    "ampx:sandbox": "ampx sandbox",
    "ampx:deploy": "ampx pipeline-deploy --branch main",
    "ampx:generate-outputs": "ampx generate outputs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.972.0",
    "@aws-sdk/client-dynamodb": "3.972.0",
    "@aws-sdk/client-sesv2": "^3.972.0",
    "@aws-sdk/lib-dynamodb": "3.972.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "aws-amplify": "6.16.3",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "1.21.1",
    "@aws-amplify/backend-cli": "1.8.2",
    "@capacitor/assets": "^3.0.5",
    "@types/aws-lambda": "8.10.161",
    "@types/node": "24.0.13",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.2",
    "vite": "5.4.19"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
